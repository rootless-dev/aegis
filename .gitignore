# Local environment. Carries secrets — the master key above all — and must
# never be committed. Use .env.example to document which variables exist.
.env
.env.*
!.env.example

# Local configuration file. May carry secrets, and is machine specific.
/aegis.yaml
!aegis.example.yaml

# Build output
/bin/
/dist/
aegisd

# Test and coverage artifacts
*.test
*.out
coverage.*

# The sqlite database the dev profile creates, and the sidecars WAL mode adds.
*.dev.db
*.dev.db-shm
*.dev.db-wal

# Editors
.idea/
.vscode/
.DS_Store

# Scratch directory for subagent-driven execution: ledger, briefs and review packages.
.superpowers/
