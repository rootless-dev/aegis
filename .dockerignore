# The build context stays lean, with two deliberate exceptions below.

.idea/
.vscode/
.DS_Store

# Never ship local secrets into an image.
.env
.env.*
!.env.example

*.test
*.out
coverage.*
tmp/

docs/
README.md

# Generated by the assets stage: otherwise COPY . . carries whatever the
# developer has on disk.
internal/templates/assets/css/app.css

# .git is NOT ignored on purpose: the toolchain reads it to stamp the revision
# and the build time into the binary. Excluding it makes that information
# disappear with no warning.

# bin/ is ignored except for the binary the tilt stage expects.
bin/*
!bin/aegisd
