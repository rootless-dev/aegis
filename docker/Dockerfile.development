# syntax=docker/dockerfile:1
#
# Development image used by docker compose: the source is mounted and compiled
# inside the container by air, with delve listening for a debugger.
#
# Runs as root on purpose. Air rewrites the binary in place and delve needs to
# trace the process; this image never leaves a developer machine.

ARG GO_VERSION=1.26
ARG AIR_VERSION=v1.67.4
ARG DELVE_VERSION=v1.27.1

# Debian, not -alpine: the standalone Tailwind CLI is a Bun-compiled binary
# linked against glibc and aborts on musl, gcompat installed or not.
FROM golang:${GO_VERSION} AS development

WORKDIR /src

# make and curl are for `make assets`, which air runs before every rebuild.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

ARG AIR_VERSION
ARG DELVE_VERSION

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@${AIR_VERSION} && \
    go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION}

# 7500 serves, 2345 is the delve listener.
EXPOSE 7500 2345

CMD ["air", "-c", ".air.toml"]
