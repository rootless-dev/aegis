# syntax=docker/dockerfile:1
#
# Production image, and the debug variant of the very same binary.
# Build from the repository root: docker build -f docker/Dockerfile.production .
#
# GO_VERSION is injected by the Makefile so the toolchain is declared in a
# single place across every Dockerfile here.

ARG GO_VERSION=1.26
ARG DEBIAN_VERSION=bookworm-slim

# The output is plain CSS, so this stage runs once on the build platform and is
# shared by every target.
#
# Debian, not Alpine: the standalone Tailwind CLI is a Bun-compiled binary linked
# against glibc and aborts on musl, gcompat installed or not. It is the one
# exception in this file.
FROM --platform=$BUILDPLATFORM debian:${DEBIAN_VERSION} AS assets

WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Makefile tailwind.sha256 ./
COPY internal/templates ./internal/templates

RUN make assets

# Pinned to BUILDPLATFORM so the compiler runs natively. Without it buildx
# emulates it under QEMU for each target architecture, which is about an order
# of magnitude slower. Go cross compiles on its own.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder

WORKDIR /src

# git is read at build time: the toolchain stamps the revision and build time
# into the binary from the repository, with no linker flags involved.
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

ARG TARGETOS
ARG TARGETARCH
# Only the semantic version needs injecting; revision and time come for free.
ARG VERSION=devel

COPY . .
# Order is load-bearing: copying from the assets stage after COPY . . is what
# makes the generated file win over whatever the repository has on disk.
COPY --from=assets /src/internal/templates/assets/css/app.css ./internal/templates/assets/css/app.css

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w -X github.com/rootless-dev/aegis/internal/buildinfo.version=${VERSION}" \
      -o /out/aegisd ./cmd/aegisd

# What every environment runs: no shell, no package manager, non-root.
FROM gcr.io/distroless/static-debian12:nonroot AS production

COPY --from=builder /out/aegisd /aegisd

EXPOSE 7500
USER nonroot:nonroot
ENTRYPOINT ["/aegisd"]

# The same binary from the same builder, on an image carrying a busybox, for
# the day something has to be inspected in place. Nothing is recompiled, so
# what runs here is what runs in production.
FROM gcr.io/distroless/static-debian12:debug-nonroot AS debug

COPY --from=builder /out/aegisd /aegisd

EXPOSE 7500
USER nonroot:nonroot
ENTRYPOINT ["/aegisd"]
