# Environment variables override the configuration file, which overrides the
# defaults. Every variable is optional. An empty value counts as absent, so a
# default cannot be cleared by exporting the variable empty.
#
# See aegis.example.yaml for the file equivalent of everything below.

# Path to the configuration file. When set, the file has to exist.
# AEGIS_CONFIG_FILE=/etc/aegis/aegis.yaml

APP_NAME=Aegis

# Execution profile: prod or dev. The --dev flag wins over this variable, which
# wins over the file. Production is the default.
AEGIS_PROFILE=prod

# Where clients reach this deployment. Required in production.
PUBLIC_URL=https://auth.example.com

LOGGING_LEVEL=INFO
LOGGING_CALLER_LEVEL=1
LOGGING_TIME_FIELD=
LOGGING_TIME_FORMAT=2006-01-02 15:04:05
LOGGING_PRETTY_ENABLED=true

HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=7500
# Durations take a unit: 15s, 1m30s, 500ms. A bare number is rejected.
HTTP_SERVER_READ_HEADER_TIMEOUT=5s
HTTP_SERVER_READ_TIMEOUT=15s
HTTP_SERVER_WRITE_TIMEOUT=15s
HTTP_SERVER_IDLE_TIMEOUT=60s
HTTP_SERVER_REQUEST_TIMEOUT=10s
HTTP_SERVER_MAX_HEADER_BYTES=1048576

# Who terminates TLS: app, proxy or none. No default outside the dev profile —
# a deployment that never says has to fail rather than inherit a guess.
TLS_TERMINATION=proxy
# Only for TLS_TERMINATION=app, PEM encoded.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_RELOAD_INTERVAL=1h

# Comma separated CIDR blocks or addresses. Required by TLS_TERMINATION=proxy
# and refused by the other two.
PROXY_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
# Which family the gateway writes: x-forwarded or forwarded (RFC 7239).
PROXY_HEADERS=x-forwarded

HSTS_ENABLED=true
HSTS_MAX_AGE=8760h
HSTS_INCLUDE_SUBDOMAINS=false

# One of: postgres, mysql, mariadb, sqlite. No default outside the dev
# profile — only the operator knows which engine they run.
DATABASE_DRIVER=postgres
DATABASE_HOST=db.internal
# Left empty, the engine's own default is used: 5432 or 3306.
DATABASE_PORT=5432
DATABASE_NAME=aegis
DATABASE_USER=aegis
# The only route for the password: it cannot be read from the configuration
# file, so a secret that lives there cannot get committed by mistake.
DATABASE_PASSWORD=

# sqlite only, and only under the dev profile.
# DATABASE_PATH=./aegis.dev.db

# disable, prefer, require, verify-ca or verify-full. require encrypts
# without authenticating the server; only the two verify- levels do. Required
# outside the dev profile: left empty it would mean prefer, which drops back to
# an unencrypted connection without saying so.
DATABASE_SSL_MODE=verify-full
# Only read by the two verify- modes.
DATABASE_SSL_ROOT_CERT=/etc/aegis/db-ca.pem

DATABASE_CONNECT_TIMEOUT=10s

DATABASE_POOL_MAX_OPEN=25
# Matches MAX_OPEN by default; see aegis.example.yaml for why.
DATABASE_POOL_MAX_IDLE=25
DATABASE_POOL_CONN_MAX_LIFETIME=30m
DATABASE_POOL_CONN_MAX_IDLE_TIME=5m

GRACEFUL_SHUTDOWN_TIMEOUT=20s

HEALTH_CHECK_TIMEOUT=2s
HEALTH_DRAIN_DELAY=5s

# Version, revision and build time are not configurable: they are stamped into
# the binary at build time and reported by internal/buildinfo.
BANNER_ENABLED=true

# --- Tooling, read by the Makefile rather than by the service ---
# Analysis server and a token generated under its account security page.
# SONAR_HOST_URL=
# SONAR_TOKEN=
