# Environment variables override the configuration file, which overrides the
# defaults. Every variable is optional. An empty value counts as absent, so a
# default cannot be cleared by exporting the variable empty.
#
# See aegis.example.yaml for the file equivalent of everything below.

# Path to the configuration file. When set, the file has to exist.
# AEGIS_CONFIG_FILE=/etc/aegis/aegis.yaml

APP_NAME=Aegis

LOGGING_LEVEL=INFO
LOGGING_CALLER_LEVEL=1
LOGGING_TIME_FIELD=
LOGGING_TIME_FORMAT=2006-01-02 15:04:05
LOGGING_PRETTY_ENABLED=true

HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=7500
# Durations take a unit: 15s, 1m30s, 500ms. A bare number is rejected.
HTTP_SERVER_READ_HEADER_TIMEOUT=5s
HTTP_SERVER_READ_TIMEOUT=15s
HTTP_SERVER_WRITE_TIMEOUT=15s
HTTP_SERVER_IDLE_TIMEOUT=60s
HTTP_SERVER_REQUEST_TIMEOUT=10s
HTTP_SERVER_MAX_HEADER_BYTES=1048576

GRACEFUL_SHUTDOWN_TIMEOUT=20s

HEALTH_CHECK_TIMEOUT=2s
HEALTH_DRAIN_DELAY=5s

# Version, revision and build time are not configurable: they are stamped into
# the binary at build time and reported by internal/buildinfo.
BANNER_ENABLED=true

# --- Tooling, read by the Makefile rather than by the service ---
# Analysis server and a token generated under its account security page.
# SONAR_HOST_URL=
# SONAR_TOKEN=
