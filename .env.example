# Environment variables override the configuration file, which overrides the
# defaults. Every variable is optional. An empty value counts as absent, so a
# default cannot be cleared by exporting the variable empty.
#
# See aegis.example.yaml for the file equivalent of everything below.

# Path to the configuration file. When set, the file has to exist.
# AEGIS_CONFIG_FILE=/etc/aegis/aegis.yaml

AEGIS_APP_NAME=Aegis

# Execution profile: prod or dev. The --dev flag wins over this variable, which
# wins over the file. Production is the default.
AEGIS_PROFILE=prod

# Where clients reach this deployment. Required in production.
AEGIS_PUBLIC_URL=https://auth.example.com

AEGIS_LOGGING_LEVEL=INFO
AEGIS_LOGGING_CALLER_LEVEL=1
AEGIS_LOGGING_TIME_FIELD=
AEGIS_LOGGING_TIME_FORMAT=2006-01-02 15:04:05
AEGIS_LOGGING_PRETTY_ENABLED=true

AEGIS_HTTP_SERVER_HOST=0.0.0.0
AEGIS_HTTP_SERVER_PORT=7500
# Durations take a unit: 15s, 1m30s, 500ms. A bare number is rejected.
AEGIS_HTTP_SERVER_READ_HEADER_TIMEOUT=5s
AEGIS_HTTP_SERVER_READ_TIMEOUT=15s
AEGIS_HTTP_SERVER_WRITE_TIMEOUT=15s
AEGIS_HTTP_SERVER_IDLE_TIMEOUT=60s
AEGIS_HTTP_SERVER_REQUEST_TIMEOUT=10s
AEGIS_HTTP_SERVER_MAX_HEADER_BYTES=1048576

# Who terminates TLS: app, proxy or none. No default outside the dev profile —
# a deployment that never says has to fail rather than inherit a guess. The dev
# profile defaults to none; set it to app there for HTTPS on a certificate
# generated at boot, no key pair needed.
AEGIS_TLS_TERMINATION=proxy
# Only for AEGIS_TLS_TERMINATION=app, PEM encoded.
AEGIS_TLS_CERT_FILE=
AEGIS_TLS_KEY_FILE=
AEGIS_TLS_RELOAD_INTERVAL=1h

# Comma separated CIDR blocks or addresses. Required by AEGIS_TLS_TERMINATION=proxy
# and refused by the other two.
AEGIS_PROXY_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
# Which family the gateway writes: x-forwarded or forwarded (RFC 7239).
AEGIS_PROXY_HEADERS=x-forwarded

AEGIS_HSTS_ENABLED=true
AEGIS_HSTS_MAX_AGE=8760h
AEGIS_HSTS_INCLUDE_SUBDOMAINS=false

AEGIS_CSP_ENABLED=true

# One of: postgres, mysql, mariadb, sqlite. No default outside the dev
# profile — only the operator knows which engine they run.
AEGIS_DATABASE_DRIVER=postgres
AEGIS_DATABASE_HOST=db.internal
# Left empty, the engine's own default is used: 5432 or 3306.
AEGIS_DATABASE_PORT=5432
AEGIS_DATABASE_NAME=aegis
AEGIS_DATABASE_USER=aegis
# The only route for the password: it cannot be read from the configuration
# file, so a secret that lives there cannot get committed by mistake.
AEGIS_DATABASE_PASSWORD=

# sqlite only, and only under the dev profile.
# AEGIS_DATABASE_PATH=./aegis.dev.db

# disable, prefer, require, verify-ca or verify-full. require encrypts
# without authenticating the server; only the two verify- levels do. Required
# outside the dev profile: left empty it would mean prefer, which drops back to
# an unencrypted connection without saying so.
AEGIS_DATABASE_SSL_MODE=verify-full
# Only read by the two verify- modes.
AEGIS_DATABASE_SSL_ROOT_CERT=/etc/aegis/db-ca.pem

AEGIS_DATABASE_CONNECT_TIMEOUT=10s

AEGIS_DATABASE_POOL_MAX_OPEN=25
# Matches MAX_OPEN by default; see aegis.example.yaml for why.
AEGIS_DATABASE_POOL_MAX_IDLE=25
AEGIS_DATABASE_POOL_CONN_MAX_LIFETIME=30m
AEGIS_DATABASE_POOL_CONN_MAX_IDLE_TIME=5m

AEGIS_DATABASE_MIGRATE_ON_BOOT=true
AEGIS_DATABASE_MIGRATE_TIMEOUT=5m
AEGIS_DATABASE_MIGRATE_LOCK_TIMEOUT=0s

# Encrypts every realm's private signing key, and there is no way to read one
# without it. Exactly 32 bytes, base64 encoded. Required in every profile,
# development included: a fallback constant shipped in the binary would be a
# decryption key every installation shares. `make master-key` writes one into
# .env; `openssl rand -base64 32` is what it runs. Deliberately not a
# configuration file key.
AEGIS_CRYPTO_MASTER_KEY=
# Accepted in place of the variable above, pointing at a mounted secret. Setting
# both is an error. The same _FILE suffix works for the previous key below.
# AEGIS_CRYPTO_MASTER_KEY_FILE=/run/secrets/aegis-master-key

# Only while `aegisd key rewrap` is migrating rows to a new master key. With it
# set, the process opens rows sealed under either key and seals new ones under
# AEGIS_CRYPTO_MASTER_KEY.
# AEGIS_CRYPTO_MASTER_KEY_PREVIOUS=

AEGIS_GRACEFUL_SHUTDOWN_TIMEOUT=20s

AEGIS_HEALTH_CHECK_TIMEOUT=2s
AEGIS_HEALTH_DRAIN_DELAY=5s

# Version, revision and build time are not configurable: they are stamped into
# the binary at build time and reported by internal/buildinfo.
AEGIS_BANNER_ENABLED=true

# --- Tooling, read by the Makefile rather than by the service ---
# Analysis server and a token generated under its account security page.
# SONAR_HOST_URL=
# SONAR_TOKEN=
